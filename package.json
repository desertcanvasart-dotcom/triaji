{
  "name": "triaji",
  "version": "1.0.0",
  "private": true,
  "description": "دكتور تريو — Arabic-First AI Medical Triage & Booking SaaS",
  "scripts": {
    "dev": "pnpm --filter @triaji/web dev",
    "dev:admin": "pnpm --filter @triaji/admin dev",
    "dev:widget": "pnpm --filter @triaji/widget dev",
    "build:widget": "pnpm --filter @triaji/widget build && pnpm --filter @triaji/widget copy",
    "build": "pnpm build:widget && pnpm --filter @triaji/web build && pnpm --filter @triaji/admin build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:rules": "pnpm --filter @triaji/rules-engine test",
    "test:normalization": "pnpm --filter @triaji/normalization test",
    "test:smoke": "pnpm --filter @triaji/web test:smoke",
    "typecheck": "pnpm -r typecheck",
    "seed:kb": "npx tsx supabase/seed/run-kb-seed.ts",
    "seed:slots": "npx tsx supabase/seed/refresh-availability.ts",
    "seed:doctors": "npx tsx supabase/seed/seed-specialty-doctors.ts",
    "embed:kb": "npx tsx supabase/seed/run-kb-embed.ts",
    "test:search": "npx tsx supabase/seed/test-semantic-search.ts"
  },
  "engines": {
    "node": ">=20.0.0 <23",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@types/react-signature-canvas>@types/react": "19.2.14",
      "recharts>@types/react": "19.2.14"
    }
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
