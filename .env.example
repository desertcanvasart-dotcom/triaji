# .env.example — copy to .env.local, never commit .env.local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # Server-side only. Never expose to client.

# Anthropic
ANTHROPIC_API_KEY=              # Server-side only.

# Cohere (embeddings)
COHERE_API_KEY=                 # Server-side only.

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# SMS Gateway (Egyptian carrier)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_NAME=Triaji

# App
NEXT_PUBLIC_APP_URL=
PLATFORM_ADMIN_SECRET=          # Used to grant platform_admin role

# HIS Integration
HIS_ENCRYPTION_KEY=             # 32-byte hex — generate with: openssl rand -hex 32
CRON_SECRET=                    # Secret header value for cron job protection

# Voice Input (Whisper)
OPENAI_API_KEY=              # For Whisper transcription only — not for LLM

# Telehealth (LiveKit)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=                 # wss://your-project.livekit.cloud

# ElevenLabs (TTS for phone)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=          # English voice ID (required if english_enabled=true for a tenant)

# Twilio (Phone Call Center)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=             # Triaji platform number (Egyptian: +20XXXXXXXXXX)
TWILIO_WEBHOOK_BASE_URL=         # https://app.triaji.com (must be public HTTPS)

# Deepgram (Real-time STT for phone)
DEEPGRAM_API_KEY=

# Redis (Upstash — OTP storage + session caching)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Expo Push Notifications
EXPO_ACCESS_TOKEN=        # From expo.dev account settings

# Lab Chain — Al-Borg
ALBORG_BASE_URL=
ALBORG_API_KEY=
ALBORG_SECRET=
ALBORG_WEBHOOK_SECRET=

# Lab Chain — Al-Mokhtabar
ALMOKHTABAR_BASE_URL=
ALMOKHTABAR_API_KEY=
ALMOKHTABAR_SECRET=
ALMOKHTABAR_WEBHOOK_SECRET=

# Lab Chain — Alfa Lab
ALFA_BASE_URL=
ALFA_API_KEY=
ALFA_SECRET=
ALFA_WEBHOOK_SECRET=

# Railway Cron Configuration (set in Railway dashboard):
# Cron schedule: */30 * * * *  (every 30 minutes)
# Command: GET https://app.triaji.com/api/cron/his-sync
# Header: x-cron-secret: {CRON_SECRET}
