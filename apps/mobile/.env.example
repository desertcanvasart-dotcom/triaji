# Mobile app environment — copy to apps/mobile/.env for local development.
# Only EXPO_PUBLIC_* variables are embedded in the app bundle; never put
# server-side secrets (e.g. the Supabase service-role key) here.

# Base URL of the web app's API (apps/web). For a device on the same network,
# use your machine's LAN IP instead of localhost, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project URL + publishable (anon) key — used for the ICU live-bed
# realtime feed. Same values as NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY in the
# root .env.local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
